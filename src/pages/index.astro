---
// Structure adapted from AI Hero SkillsHero, SkillsInstallOptions and SkillSet.
import Layout from '../layouts/Layout.astro';
import InstallCommand from '../components/InstallCommand.astro';
import {skills,groups} from '../data/skills';
import {pluginInstallCommand} from '../data/install';
---
<Layout active="home"><header class="hero" id="skills-hero"><div class="hero-grid"><div class="hero-copy"><h1>AI skills for practical engineers.</h1><p class="lede">Recover context, guide the work, and check what actually happened. A set of reusable instructions for Claude Code and Codex.</p><div class="hero-facts"><span class="skill-count"><strong>{skills.length}</strong> skills</span><a class="repo-badge" href="https://github.com/MrCoder/mrcoder.github.io"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .7A11.3 11.3 0 0 0 8.4 22.7c.6.1.8-.2.8-.5v-2.1c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.6-1.3-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.1 1.2a10.6 10.6 0 0 1 5.6 0c2.1-1.5 3.1-1.2 3.1-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.1v3.1c0 .3.2.6.8.5A11.3 11.3 0 0 0 12 .7Z"/></svg>GitHub</a></div><div class="start-cta"><div class="cta-grid"><img src="/mrcoder-mark.svg" alt="" width="99" height="98"/><h2>Recommended first skill - pitch-me</h2><p>Package the demo, result, and tradeoffs into a review-ready explainer.</p></div><a class="button" href="/skills/pitch-me/">Explore pitch-me <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></div></div><section class="hero-install" aria-label="Skill installation options"><div class="install-channel"><h2><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2L12 2Z"/></svg>Install the skills</h2><p class="install-description">Install into Claude Code or Codex with the skills CLI.</p><InstallCommand all/><div class="install-links"><span>Update: npx skills update</span><a href="/install/">Guide ↗</a></div></div><div class="install-channel"><h2><img src="/claude-mark.svg" alt=""/>Claude Code</h2><p class="install-description">Install as a managed Claude Code plugin.</p><InstallCommand command={pluginInstallCommand}/><div class="install-links"><span>Managed plugin</span><a href="/install/#claude-plugin">Add the marketplace first ↗</a></div></div><div class="install-foot"><h3>Built for your coding agent</h3><p>Claude Code · Codex · {skills.length} skills</p><p>Local instructions. No account required.</p></div></section></div></header><section class="catalogue" aria-label="Skills"><div class="catalogue-heading"><h2 id="skill-set-heading">The skill set</h2><p class="lede">Pick the skill for the task in front of you. Start with the main workflow, and add other practices when you need them.</p><div class="search js-only"><label for="skill-search" class="sr-only">Search skills by name or task</label><input id="skill-search" type="search" placeholder="Search skills…"/><button type="button" id="reset-search" aria-label="Clear search">Clear</button></div></div><p class="search-status sr-only" aria-live="polite"></p><div class="no-results" hidden><h3>No skills found</h3><p>Try “history”, “diagram”, or “review”, or clear your search.</p></div>{groups.map(g=><section class:list={['skill-group',g.id==='optional'&&'optional-group']} id={`group-${g.id}`}><div class="group-intro"><h3>{g.number&&<span class="group-number" aria-hidden="true">{g.number}</span>}{g.title}</h3><p>{g.description}</p>{g.id!=='optional'&&<p class="start-with">Start with <a href={`/skills/${skills.find(s=>s.group===g.id)?.slug}/`}>/{skills.find(s=>s.group===g.id)?.name}</a></p>}</div><div class="skill-rows">{skills.filter(s=>s.group===g.id).map(s=><article class="skill-row" id={s.slug} data-search={`${s.name} ${s.slug} ${s.summary} ${s.when} ${s.slug==='no-bs'?'renhua plain language explain':''}`}><a href={`/skills/${s.slug}/`}><img class="row-mark" src="/mrcoder-mark.svg" alt="" width="40" height="40"/><div><span class="slash-command">/{s.name}</span><h4>The /{s.name} Skill</h4><p>{s.summary}</p></div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></article>)}</div></section>)}</section><section class="closing"><h2>What is a skill?</h2><p class="statement">A reusable set of instructions that teaches your coding agent how to handle a specific task.</p><p>Instead of writing the same detailed prompt each time, install the skill and ask your agent to use it. Each package includes a <code>SKILL.md</code> file, plus supporting files when needed.</p><p>The guide explains when to use each skill and what to expect. The package contains the instructions your agent reads.</p><a class="text-link" href="/about/">More about these skills ↗</a></section><section class="source-section"><h2>Read the source. Make it yours.</h2><p class="lede">Inspect the instructions and complete packages in the repository before installing.</p><a class="button" href="https://github.com/MrCoder/mrcoder.github.io">View on GitHub ↗</a></section></Layout>
<script>
const input=document.querySelector<HTMLInputElement>('#skill-search')!;const rows=[...document.querySelectorAll<HTMLElement>('.skill-row')];function search(){const q=input.value.toLowerCase().trim();let count=0;rows.forEach(row=>{row.hidden=!row.dataset.search?.toLowerCase().includes(q);if(!row.hidden)count++});document.querySelectorAll<HTMLElement>('.skill-group').forEach(g=>g.hidden=![...g.querySelectorAll<HTMLElement>('.skill-row')].some(r=>!r.hidden));(document.querySelector('.no-results') as HTMLElement).hidden=count>0;document.querySelector('.search-status')!.textContent=`${count} ${count===1?'skill':'skills'} found.`}input.addEventListener('input',search);document.querySelector('#reset-search')?.addEventListener('click',()=>{input.value='';search();input.focus()});
</script>
