---
import Layout from '../../layouts/Layout.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import {skills,groups} from '../../data/skills';
export function getStaticPaths(){return [...skills.map(skill=>({params:{slug:skill.slug},props:{skill}})),{params:{slug:'renhua'},props:{skill:null}}]}
const {skill}=Astro.props;const group=skill&&groups.find(g=>g.id===skill.group);
---
<Layout title={skill?.name||'renhua'} description={skill?.summary||'The backwards-compatible alias for no-bs.'} active={skill?.slug}><div class="detail-layout"><div class="document"><a class="back" href="/">← All skills</a>{skill?<><header class="doc-header"><p class="intro">{group?.title}</p><h1>The /{skill.name} Skill</h1><p class="lede">{skill.summary}</p><a class="text-link" href={`/skills/${skill.slug}/SKILL.md`}>Read the agent instructions ↗</a></header><details class="mobile-toc"><summary>On this page</summary><nav class="contents" aria-label="On this page"><a href="#when">When to use it</a><a href="#example">Example</a><a href="#requirements">Requirements</a><a href="#install">Install</a></nav></details><section id="when"><h2>When to use it</h2><p>{skill.when}</p></section><section id="example"><h2>Try it with your agent</h2><pre class="example"><code>{skill.example}</code></pre></section><section><h2>What you get</h2><ul>{skill.outputs.map((x:string)=><li>{x}</li>)}</ul></section><section id="requirements"><h2>Requirements and boundaries</h2><ul>{skill.requirements.map((x:string)=><li>{x}</li>)}</ul>{skill.notes.map((x:string)=><p>{x}</p>)}</section><section id="install"><h2>Install {skill.name}</h2><p>Choose your agent, then run the command in your terminal. Read the <a href="/install/">installation guide</a> for package setup and update notes.</p><InstallCommand slug={skill.slug} chooseAgent/>{['no-bs','search-conversation-history'].includes(skill.slug)&&<p>Optional complete package: <a href={`/downloads/${skill.slug}.zip`}>Download ZIP</a> · <a href={`/downloads/${skill.slug}.zip.sha256`}>SHA-256 checksum</a>. Verify before extracting.</p>}{skill.slug==='search-conversation-history'&&<><h3>Build the local history index</h3><p>For a project installation, run the command for your agent from the project root. Use the global path only when you chose global installation.</p><pre class="example"><code>{`# Project: Claude Code
python3 .claude/skills/search-conversation-history/scripts/history.py index
# Project: Codex
python3 .agents/skills/search-conversation-history/scripts/history.py index
# Global: Claude Code
python3 ~/.claude/skills/search-conversation-history/scripts/history.py index
# Global: Codex
python3 ~/.codex/skills/search-conversation-history/scripts/history.py index`}</code></pre></>}</section>{skill.related.length>0&&<section><h2>Related skills</h2><div class="related">{skill.related.map((slug:string)=>{const s=skills.find(x=>x.slug===slug);return s&&<a href={`/skills/${s.slug}/`}><strong>{s.name}</strong><span>{s.summary}</span></a>})}</div></section>}</>:<><header class="doc-header"><p class="intro">Backwards-compatible alias</p><h1>renhua</h1><p class="lede">The earlier name for no-bs. Both names lead to the same plain-language explanation skill.</p></header><section><h2>Use no-bs for new installations</h2><p>The raw renhua instructions remain available for existing setups. The catalogue counts no-bs and renhua as one skill.</p><a class="button" href="/skills/no-bs/">Read the no-bs guide</a><p><a href="/skills/renhua/SKILL.md">Read renhua SKILL.md</a></p></section></>}</div>{skill&&<aside class="detail-toc"><h2>On this page</h2><a href="#when">When to use it</a><a href="#example">Example</a><a href="#requirements">Requirements</a><a href="#install">Install</a><a href={`/skills/${skill.slug}/SKILL.md`}>Agent instructions ↗</a></aside>}</div></Layout>
