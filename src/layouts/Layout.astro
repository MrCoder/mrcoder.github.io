---
// Adapted from badass-courses/ai-hero hub-layout/sidebar-shell/footer, commit 7a9fca0.
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import {skills,groups} from '../data/skills';
const {title='MrCoder Skills',description='Practical skills for better work with coding agents.',active=''}=Astro.props;
const canonical=new URL(Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname,'https://mrcoder.github.io');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title==='MrCoder Skills'?title:`${title} · MrCoder Skills`}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://mrcoder.github.io/social.png"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://mrcoder.github.io/social.png"/><link rel="icon" href="/favicon.svg?v=mr1"/><script is:inline>document.documentElement.classList.add('js');try{const t=localStorage.getItem('field-guide-theme');if(t&&t!=='system')document.documentElement.dataset.theme=t}catch{}</script></head><body><a class="skip" href="#main">Skip to content</a><div class="announcement"><a href="/install/">Install skills for Claude Code and Codex. <span aria-hidden="true">→</span></a></div><header class="header"><a class="brand" href="/">MrCoder <span>Skills</span></a><nav class="top-nav" aria-label="Main"><a href="/" aria-current={active==='home'?'page':undefined}>Skills</a><a href="/install/" aria-current={active==='install'?'page':undefined}>Install</a><a href="/about/" aria-current={active==='about'?'page':undefined}>About</a><a href="https://github.com/MrCoder/mrcoder.github.io">GitHub <span aria-hidden="true">↗</span></a></nav><a class="header-cta" href="/install/">Get the skills</a><button class="menu-toggle js-only" type="button" aria-expanded="false" aria-controls="catalogue-navigation" aria-label="Open navigation"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button></header><div class="shell"><aside class="sidebar" id="catalogue-navigation"><nav aria-label="Skill catalogue"><p class="sidebar-label">Explore</p><a class="overview" href="/" aria-current={active==='home'?'page':undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>All skills</a><a class="overview" href="/install/" aria-current={active==='install'?'page':undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3v12m-5-5 5 5 5-5M4 15v6h16v-6"/></svg>Installation guide</a><p class="sidebar-label section-label">Skill groups</p>{groups.map(g=><details class="nav-group" open={skills.some(s=>s.group===g.id&&s.slug===active)}><summary><span>{g.number&&<small>{g.number}</small>}{g.title}</span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><path d="m6 4 4 4-4 4"/></svg></summary><div class="nested-nav">{skills.filter(s=>s.group===g.id).map(s=><a href={`/skills/${s.slug}/`} aria-current={active===s.slug?'page':undefined}>{s.name}</a>)}</div></details>)}<p class="sidebar-label section-label">Resources</p><a class="overview" href="/about/">About the skills</a><a class="overview" href="https://github.com/MrCoder/mrcoder.github.io/tree/master/skills">Source packages ↗</a></nav></aside><div class="content-column"><main id="main"><slot/></main><footer><div class="footer-grid"><div class="footer-brand"><a class="brand" href="/">MrCoder <span>Skills</span></a><p>Practical skills for working<br/>with coding agents.</p></div><div><h3>Skills</h3><a href="/#group-understand">Understand and recover</a><a href="/#group-work">Work through the task</a><a href="/#group-verify">Verify and present</a><a href="/#group-optional">Optional practices</a></div><div><h3>Get started</h3><a href="/install/">Installation guide</a><a href="/about/">About</a><a href="https://github.com/MrCoder/mrcoder.github.io">GitHub</a><a href="https://github.com/MrCoder/ai-hero">AI Hero fork</a></div><div><h3>For your agent</h3><a class="mono" href="/skills/no-bs/SKILL.md">no-bs/SKILL.md</a><a class="mono" href="/skills/unattended/SKILL.md">unattended/SKILL.md</a><a class="mono" href="/skills/diagram/SKILL.md">diagram/SKILL.md</a><a class="mono" href="https://github.com/MrCoder/mrcoder.github.io/tree/master/skills">All packages ↗</a></div></div><div class="footer-bottom"><span>Made by <a href="https://github.com/MrCoder">Peng Xiao</a></span><a href="/about/">Sources and licences</a><label class="theme-control js-only"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 1v3m0 16v3M1 12h3m16 0 2 2M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></svg><span class="sr-only">Colour theme</span><select id="theme-select" aria-label="Colour theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label></div></footer></div></div><script>
const theme=document.querySelector<HTMLSelectElement>('#theme-select');try{if(theme)theme.value=localStorage.getItem('field-guide-theme')||'system'}catch{}theme?.addEventListener('change',()=>{if(theme.value==='system')delete document.documentElement.dataset.theme;else document.documentElement.dataset.theme=theme.value;try{localStorage.setItem('field-guide-theme',theme.value)}catch{}});
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const rail=document.querySelector<HTMLElement>('.sidebar');function closeMenu(){rail?.classList.remove('mobile-open');menu?.setAttribute('aria-expanded','false');menu?.setAttribute('aria-label','Open navigation')}menu?.addEventListener('click',()=>{const open=rail?.classList.toggle('mobile-open');menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Close navigation':'Open navigation')});document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu();menu?.focus()}});rail?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));matchMedia('(min-width:1024px)').addEventListener('change',closeMenu);
</script><script is:inline define:vars={{productionHostname:Astro.site?.hostname}}>if(window.location.hostname===productionHostname){const analytics=document.createElement('script');analytics.type='module';analytics.src='/assets/analytics.js';document.body.appendChild(analytics);}</script></body></html>
